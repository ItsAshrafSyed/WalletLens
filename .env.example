# Server-only HTTPS endpoint for a Solana MAINNET RPC provider.
# Never use a NEXT_PUBLIC_ prefix for this value.
SOLANA_RPC_URL=

# Optional private analytics. Set all three to enable durable recording.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Independent random secrets, each at least 32 characters. Never use NEXT_PUBLIC_.
STATS_HASH_KEY=
STATS_ADMIN_TOKEN=
